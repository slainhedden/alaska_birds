{
  "name": "bird-learner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "playwright test",
    "ingest:audio": "node scripts/ingest-audio.mjs",
    "fetch:sounds": "node scripts/fetch-commons-audio.mjs --clean",
    "fetch:images": "node scripts/fetch-wikimedia-images.mjs",
    "test:audio-ingest": "node scripts/test-audio-ingest.mjs",
    "test:images": "node scripts/test-image-manifest.mjs",
    "test:sounds": "node scripts/test-sound-manifest.mjs",
    "validate": "npm run lint && npm run test:images && npm run test:sounds && npm run test:audio-ingest && npm run build && npm run test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "vite": "^7.2.7",
    "typescript": "^5.9.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "lucide-react": "^0.562.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.49.0"
  }
}
